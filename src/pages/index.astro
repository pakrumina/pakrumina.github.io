---
import { HERO_DESCRIPTION, HERO_TITLE } from '../consts';
import CtaSection from '../components/CtaSection.astro';
import HeroSection from '../components/HeroSection.astro';
import ScrollRow from '../components/ScrollRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Patrīcija Krūmiņa">
	<HeroSection
		titleLead={HERO_TITLE.lead}
		titleMain={HERO_TITLE.main}
		description={HERO_DESCRIPTION}
	/>
	<section class="partners" aria-label="Partners">
		<ScrollRow />
	</section>
	<CtaSection />
</BaseLayout>

<style>
	.partners {
		position: relative;
		width: 100%;
		padding-block: 8rem 0;
		background-color: var(--color-bg);
	}

	@media (max-width: 47.999rem) {
		.partners {
			padding-block: 5rem 0;
		}
	}

	@media (min-width: 64rem) {
		.partners {
			padding-block: 12rem 6rem;
		}
	}
</style>
