---
import ProjectCase from '../../components/ProjectCase.astro';
import ProjectNextSection from '../../components/ProjectNextSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const projectList = await getCollection('projects');
const currentHref = `/projects/${project.id}`;
const currentIndex = projectList.findIndex((item) => project.id === item.id);
const nextProject = projectList[(currentIndex + 1) % projectList.length];
---

<BaseLayout title={project.data.title} description={project.data.description}>
	<ProjectCase project={project} />
	<ProjectNextSection name={nextProject.data.title} href=`/projects/${nextProject.id}` />
</BaseLayout>
