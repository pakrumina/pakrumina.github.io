---
import type { CollectionEntry } from 'astro:content';
import { BLOG_LINK, BLOG_TITLE } from '../consts';
import BlogCard from './BlogCard.astro';
import availableCategoriesJson from '../content/site/categories.json';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const availableCategories = getAvailableCategories();
const { posts } = Astro.props;

function charsOf(label: string) {
	return [...label].map((char) => (char === ' ' ? '\u00A0' : char));
}

function getAvailableCategories() {
	const categories = availableCategoriesJson.categories.map(c => c.name);
	categories.unshift("Visas");
	return categories;
}

function isDefaultActive(cat: string) {
	return cat === 'Visas';
}
---

<section class="blog" id="blog" aria-label="Blog" data-blog>
	<div class="blog__inner">
		<header class="blog__header">
			<h1 class="blog__title">
				<span class="blog__title-lead" data-blog-reveal>{BLOG_TITLE.lead}</span>
				<span class="blog__title-main" data-blog-reveal>{BLOG_TITLE.main}</span>
			</h1>
			<a class="blog__button" href="/contact" data-blog-link-hover aria-label={BLOG_LINK}>
				<span class="blog__button-mask" aria-hidden="true">
					{
						charsOf(BLOG_LINK).map((char) => (
							<span class="blog__char-col">
								<span class="blog__char-track">
									<span class="blog__char">{char}</span>
									<span class="blog__char">{char}</span>
								</span>
							</span>
						))
					}
				</span>
			</a>
		</header>
		<div class="category-filter" data-category-filter>
			{availableCategories.map((cat) => (
				<a
					href="#"
					class:list={['category-filter__btn', { 'is-active': isDefaultActive(cat) }]}
					aria-label={cat}
					name={cat}
					data-filter-link
					data-filter-hover
					onclick={`toggleFiltering('${cat}', event)`}
				>
					<span class="category-filter__mask" aria-hidden="true">
						{charsOf(cat).map((char) => (
							<span class="category-filter__char-col">
								<span class="category-filter__char-track">
									<span class="category-filter__char">{char}</span>
									<span class="category-filter__char">{char}</span>
								</span>
							</span>
						))}
					</span>
				</a>
			))}
		</div>
		<ul class="blog__grid" data-blog-grid>
			{
				posts.map((post) => (
					<li class="blog__item" data-categories={post.data.categories}>
						<BlogCard post={post} />
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
    import { length } from 'astro:schema';
import gsap from 'gsap';
	var activeCategories = ['Visas'];

	window.toggleFiltering = function(category, event) {
        event.preventDefault();

		const clickedEl = event.target.closest('a');
		const filterContainer = clickedEl.closest('[data-category-filter]');
        const allButtons = filterContainer.querySelectorAll('.category-filter__btn');
		const selectAllButton = Array.from(allButtons).find(l => l.getAttribute('name') === 'Visas');
		const grid = document.querySelector('[data-blog-grid]');
		const items = grid.querySelectorAll('.blog__item');

		if (category === 'Visas') {
			activeCategories = ['Visas'];
			allButtons.forEach(l => l.classList.remove('is-active'));
            clickedEl.classList.add('is-active');
		} else {
			if (activeCategories.includes(category)) {
				activeCategories = activeCategories.filter(cat => cat !== 'Visas' && cat !== category);
				clickedEl.classList.remove('is-active');

				if (activeCategories.length == 0) {
					activeCategories = ['Visas'];
					selectAllButton.classList.add('is-active');
				} else {
					selectAllButton.classList.remove('is-active');
				}
			} else {
				activeCategories = activeCategories.filter(cat => cat !== 'Visas');
				activeCategories.push(category);
				clickedEl.classList.add('is-active');
				selectAllButton.classList.remove('is-active');
			}
		}

		const showAll = activeCategories.length == 0 || activeCategories.includes('Visas')
		
		items.forEach(item => {
			if (showAll) {
				item.style.display = '';
				return;
			}
			const itemCategories = item.getAttribute('data-categories');

			if (!itemCategories || itemCategories == "") {
				item.style.display = 'none';
				return;
			}
			const isMatch = activeCategories.some(cat => itemCategories.split(',').includes(cat));
			item.style.display = isMatch ? '' : 'none';
		});
    };

    function initFilterHover() {
        const filterContainer = document.querySelector('[data-category-filter]');
        if (!filterContainer) return;

        const mm = gsap.matchMedia();
        mm.add('(prefers-reduced-motion: no-preference)', () => {
            const cleanups: Array<() => void> = [];

            filterContainer.querySelectorAll('[data-filter-hover]').forEach((link) => {
                const tracks = link.querySelectorAll('.category-filter__char-track');
                if (tracks.length === 0) return;

                gsap.set(tracks, { yPercent: 0 });

                let hoverTl: ReturnType<typeof gsap.to> | undefined;

                const playHover = () => {
                    hoverTl?.kill();
                    hoverTl = gsap.to(tracks, {
                        yPercent: -50,
                        duration: 0.35,
                        ease: 'power3.out',
                        stagger: 0.03,
                        overwrite: true,
                    });
                };

                const resetHover = () => {
                    hoverTl?.kill();
                    hoverTl = gsap.to(tracks, {
                        yPercent: 0,
                        duration: 0.35,
                        ease: 'power3.out',
                        stagger: 0.03,
                        overwrite: true,
                    });
                };

                link.addEventListener('mouseenter', playHover);
                link.addEventListener('mouseleave', resetHover);
                link.addEventListener('focus', playHover);
                link.addEventListener('blur', resetHover);

                cleanups.push(() => {
                    hoverTl?.kill();
                    link.removeEventListener('mouseenter', playHover);
                    link.removeEventListener('mouseleave', resetHover);
                    link.removeEventListener('focus', playHover);
                    link.removeEventListener('blur', resetHover);
                });
            });

            return () => {
                cleanups.forEach((cleanup) => cleanup());
            };
        });
    }

    initFilterHover();
    document.addEventListener('astro:after-swap', initFilterHover);
</script>

<style>
	.category-filter {
		display: flex;
		margin-top: 2rem;
		align-items: center;
		gap: 0.75rem;
		flex: 1;
	}

	.category-filter__btn{
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.55rem 1.35rem;
		border-radius: 6rem;
		background-color: #000;
		color: #fff;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.04rem;
		line-height: 1.2;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition: background-color 0.2s ease;
	}

	.category-filter__btn:hover,
	.is-active {
		background-color: #2e2e2e;
	}

	.category-filter__mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.2em;
		line-height: 1.2;
	}

	.category-filter__char-col {
		display: block;
		overflow: hidden;
		height: 1.2em;
		line-height: 1.2;
	}

	.category-filter__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.category-filter__char {
		display: block;
		flex: 0 0 1.2em;
		height: 1.2em;
		line-height: 1.2;
	}

	.blog {
		width: 100%;
		padding-block: 11rem 5rem;
		background-color: var(--color-bg);
	}

	.blog__inner {
		width: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.blog__header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
	}

	.blog__title {
		display: flex;
		flex-direction: column;
		margin: 0;
		min-width: 0;
		color: var(--color-fg);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 4.125rem;
		line-height: 0.95;
		letter-spacing: -0.06rem;
	}

	.blog__title-main {
		color: #737373;
	}

	.blog__title :global(.blog-reveal-line) {
		padding-bottom: 0.08em;
	}

	.blog__button {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		margin-bottom: 0.08em;
		padding: 0.9rem 1.6rem;
		border-radius: 999rem;
		background-color: #000;
		color: #fff;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.9375rem;
		line-height: 1.4;
		letter-spacing: -0.01rem;
		text-decoration: none;
		isolation: isolate;
		transition: background-color 0.45s ease;
	}

	.blog__button-mask {
		display: inline-flex;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.blog__char-col {
		display: block;
		overflow: hidden;
		height: 1.4em;
		line-height: 1.4;
	}

	.blog__char-track {
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	.blog__char {
		display: block;
		flex: 0 0 1.4em;
		height: 1.4em;
		line-height: 1.4;
	}

	.blog__button:hover,
	.blog__button:focus-visible {
		background-color: #2e2e2e;
		outline: none;
	}

	.blog__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}

	.blog__item {
		min-width: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.blog__button {
			transition: none;
		}
	}

	@media (min-width: 48rem) {
		.blog {
			padding-block: 12rem 6rem;
		}

		.blog__inner {
			padding-inline: 2rem;
		}

		.blog__title {
			font-size: 6.5rem;
			letter-spacing: -0.12rem;
		}

		.blog__button {
			padding: 1rem 1.85rem;
			font-size: 1rem;
		}

		.blog__header {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
		}

		.blog__grid {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
			margin-top: 4rem;
		}
	}

	@media (min-width: 64rem) {
		.blog {
			padding-block: 13rem 7rem;
		}

		.blog__inner {
			padding-inline: 2.5rem;
		}

		.blog__title {
			font-size: 8.75rem;
			letter-spacing: -0.24rem;
		}

		.blog__button {
			padding: 1.05rem 2.1rem;
			font-size: 1.0625rem;
		}

		.blog__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.75rem;
			margin-top: 5rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	let destroyBlogMotion: (() => void) | undefined;

	function initBlogMotion() {
		destroyBlogMotion?.();

		const section = document.querySelector('[data-blog]');
		if (!(section instanceof HTMLElement)) return;

		const mm = gsap.matchMedia();
		mm.add('(prefers-reduced-motion: no-preference)', () => {
			const cleanups: Array<() => void> = [];
			const header = section.querySelector('.blog__header');
			const revealTargets = section.querySelectorAll('[data-blog-reveal]');

			if (header instanceof HTMLElement && revealTargets.length > 0) {
				const split = SplitText.create(revealTargets, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					aria: 'auto',
					linesClass: 'blog-reveal-line',
					onSplit(self) {
						return gsap.from(self.lines, {
							yPercent: 110,
							duration: 0.95,
							ease: 'power3.out',
							stagger: 0.12,
							scrollTrigger: {
								trigger: header,
								start: 'top 80%',
								once: true,
							},
						});
					},
				});

				cleanups.push(() => split.revert());
			}

			return () => {
				cleanups.forEach((cleanup) => cleanup());
			};
		});

		destroyBlogMotion = () => {
			mm.revert();
			destroyBlogMotion = undefined;
		};
	}

	initBlogMotion();
	document.addEventListener('astro:after-swap', initBlogMotion);
</script>
